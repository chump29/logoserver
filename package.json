{
  "name": "@postfmly/logoserver",
  "version": "1.0.10",
  "description": "Logo server",
  "keywords": [
    "logo",
    "server"
  ],
  "homepage": "https://github.com/chump29/logoserver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logoserver.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:build": "bun run build.ts",
    "build:clean": "rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bunx tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "build:rm": "rm dist/build.d.ts",
    "clean": "rimraf bun.lock .vscode dist coverage",
    "clean:coverage": "rimraf coverage",
    "lint": "bun run lint:biome && bun run lint:env",
    "lint:biome": "biome check --write --verbose .",
    "lint:env": "dotenv-linter check .",
    "prepare": "link-configs",
    "test": "bun run clean:coverage && bun test --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "get-port": "^7.2.0",
    "http-status": "^2.1.0"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "lcov-total": "^2.1.1",
    "ms": "^2.1.3",
    "rimraf": "^6.1.3",
    "valibot": "^1.4.1"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.3.0",
    "@postfmly/logger": "^1.0.12"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true
}
