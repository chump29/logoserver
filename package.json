{
  "name": "@postfmly/logoserver",
  "version": "1.2.8",
  "description": "Logo server",
  "keywords": [
    "logo",
    "server"
  ],
  "homepage": "https://github.com/chump29/logoserver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logoserver.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:build": "bun run --bun build.ts",
    "build:clean": "bun run --bun rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bun run --bun tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "build:rm": "bun run --bun rimraf dist/build.d.ts dist/tests dist/env.config.d.ts",
    "check": "bunx --bun depcheck --ignores=\"@types/*,bun,bun:*,lcov-total,rimraf\" || :",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:env && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:env": "bun run --bun dotenv-linter check .",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "husky",
    "scan": "bun audit && bun run --bun cve-lite --check-overrides",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "test": "bun test --isolate --dots --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:full": "bun test --isolate --bail",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev,peer --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*.{json,ts}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings",
    ".env*": "bun run --bun dotenv-linter check"
  },
  "overrides": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "chalk": "6.0.0",
    "cspell": "10.3.0",
    "cve-lite-cli": "1.34.0",
    "globals": "17.12.0",
    "ini": "7.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@marianmeres/parse-boolean": "^2.1.0",
    "@postfmly/logger": "^1.0.30",
    "@postfmly/types": "^1.0.2",
    "get-port": "^7.2.0",
    "http-status": "^2.1.0",
    "nanoid": "^6.0.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.5.1",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.4.65"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "^1.4.2"
  },
  "engineStrict": true
}
