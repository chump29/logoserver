{
  "name": "@postfmly/logoserver",
  "version": "1.3.23",
  "description": "Logo server",
  "keywords": [
    "logo",
    "server"
  ],
  "homepage": "https://github.com/chump29/logoserver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logoserver.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun,bun:*,lcov-total\"",
    "env": "bun run --bun env.ts",
    "env:test": "NODE_ENV=test bun run --bun env.ts",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun husky",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bun run --bun cve-lite --check-overrides --check-network --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "server": "NODE_ENV=test bun run --bun server.ts",
    "test": "bun test --isolate --dots --bail --check",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:full": "bun test --isolate --bail --check",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --dot --no-must-find-files",
    "*.{json,md,ts}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings"
  },
  "overrides": {
    "undici-types": "8.12.3"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@postfmly/logger": "^1.2.6",
    "@postfmly/types": "^1.0.12",
    "envalid": "^9.0.0",
    "get-port": "^7.2.0",
    "hono": "^4.13.14",
    "http-status": "^2.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@postfmly/config": "^1.6.16",
    "bunup": "^0.16.32",
    "cve-lite-cli": "^1.40.0",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "engineStrict": true
}
