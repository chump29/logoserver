{
  "name": "@postfmly/logoserver",
  "version": "1.0.3",
  "description": "Logo server",
  "keywords": [
    "logo",
    "server"
  ],
  "homepage": "https://github.com/chump29/logoserver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/logoserver.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:build": "bun build index.ts --target bun --minify --outdir dist",
    "build:clean": "rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bunx tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "build:rm": "rm dist/index.test.d.ts",
    "clean": "rimraf node_modules bun.lock .vscode dist",
    "postinstall": "config-init",
    "lint": "biome check --write --verbose .",
    "test": "bun test --coverage --isolate"
  },
  "dependencies": {
    "@postfmly/logger": "^1.0.1",
    "get-port": "^7.2.0",
    "http-status": "^2.1.0"
  },
  "devDependencies": {
    "@postfmly/config": "^1.2.14",
    "rimraf": "^6.1.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "~1.3.13"
  },
  "engineStrict": true
}
